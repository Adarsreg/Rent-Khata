# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# AI tooling. Personal to whoever is working on the repo, with one exception:
# .claude/settings.json records which plugins the project expects, so it is
# shared. Note `.claude/*` rather than `.claude/` — git will not look inside an
# excluded directory, so the negation below would never match.
.claude/*
!.claude/settings.json
.agents/

# Lockfile for locally installed agent skills. The skills themselves are
# ignored above, so pinning their hashes here would lock content the repo does
# not carry.
skills-lock.json